# Copy the example JSON to a private location, then fill in the source settings.
ENDFIELD_SERVICE_CONFIG_PATH=/absolute/path/to/private/service.json
ZMD_DATA_ROOT=./data
ZMD_THREADS=1
ZMD_MAX_MEMORY_GB=4
ZMD_CONTAINER_SHM_SIZE=768m
ENDFIELD_POLL_SECONDS=300
ENDFIELD_RETRY_SECONDS=3600
ENDFIELD_DOWNLOAD_WORKERS=1
ENDFIELD_EXPORT_THREADS=1
ENDFIELD_PRESERVE_VFS=0
ZMD_PATCH_MEMORY_MB=1536
# Optional compatible notification helper directory; leave empty to disable.
ZMD_BARK_SKILL_ROOT=./config/bark
